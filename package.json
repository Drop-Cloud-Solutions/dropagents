{
  "name": "dropagents",
  "version": "0.0.0",
  "private": true,
  "description": "Event-sourced orchestrator for Claude CLI agents: plan, decompose, implement, review, test and ship across a multi-repo workspace.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:board",
    "build:board": "esbuild hosts/board-ui/board.ts --bundle --outfile=hosts/board-ui/board.js --format=iife --platform=browser --target=es2020 --legal-comments=inline",
    "db:report": "ts-node scripts/db-report.ts",
    "typecheck": "tsc --noEmit",
    "vacuum:db": "node scripts/vacuum-db.js",
    "profile:init": "tsx scripts/profile-init.ts",
    "test": "node scripts/run-tests.mjs",
    "parity-smoke": "ts-node scripts/parity-smoke.ts",
    "parity:board": "playwright test --config=test/parity/board/playwright.config.ts",
    "parity:chat": "node --test --import tsx test/parity/chat/chat-events.spec.ts",
    "dev": "ts-node hosts/orchestrator/main.ts",
    "start": "ts-node hosts/worker-api/main.ts",
    "start:manager": "ts-node hosts/manager-api/main.ts",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.1",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.27.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "testcontainers": "^10.13.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
