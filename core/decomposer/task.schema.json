{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-pipeline/schemas/task.schema.json",
  "title": "DecomposerOutput",
  "description": "AP-VP4-010 — schema for the JSON document the decomposer agent emits. Derived from the output template in agents/decomposer.CLAUDE.md (per HUMAN CLARIFICATION on this task). Validated by the orchestrator before PlanDecomposed is published; on validation failure PlanDecomposeFailed is emitted instead.",
  "type": "object",
  "required": ["plan"],
  "additionalProperties": false,
  "properties": {
    "plan": {
      "type": "object",
      "required": ["id", "title", "description", "tasks"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "approved_at": { "type": "string" },
        "tech_stack": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conventions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "namespace_root": { "type": "string" },
            "test_framework": { "type": "string" },
            "style_guide": { "type": "string" },
            "branch_pattern": { "type": "string" },
            "commit_pattern": { "type": "string" }
          }
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title", "type", "status", "dependencies", "agent", "context"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^task-[0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "scaffold",
            "scaffold-repo",
            "implement",
            "refactor",
            "integration-test",
            "document",
            "swagger",
            "deploy-nuget",
            "deploy-azure",
            "deploy-verify",
            "bump-package-reference",
            "review-codebase",
            "review-azure",
            "investigate"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["pending"]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^task-[0-9]+$"
          }
        },
        "agent": { "$ref": "#/$defs/agent" },
        "context": { "$ref": "#/$defs/context" },
        "review": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/review" }
          ]
        },
        "test": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/testBlock" }
          ]
        },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role": { "type": "string" },
        "prompt_hint": { "type": "string" },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "worktree_path": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files_to_create": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files_to_modify": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files_to_read": {
          "type": "array",
          "items": { "type": "string" }
        },
        "git_branch": { "type": "string" },
        "repo_path": { "type": "string" },
        "context_impact": {
          "type": "string",
          "enum": ["none", "possible", "likely"]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "checklist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outcome": { "type": ["string", "null"] },
        "feedback": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] },
        "iteration": { "type": "integer", "minimum": 0 }
      }
    },
    "testBlock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "coverage_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "outcome": { "type": ["string", "null"] }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "complexity": {
          "type": "string",
          "enum": ["small", "medium", "large"]
        },
        "retry_count": { "type": "integer", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "escalate_to": { "type": "string" },
        "log": { "type": "array" }
      }
    }
  }
}
