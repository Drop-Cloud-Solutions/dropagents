# dropagents — environment template.
#
# Copy this file to `.env` at the repo root; the worker-api and board-ui
# hosts load it automatically on startup via hosts/loadDotenv.ts.
# Values already set in the shell take precedence over the file.

# ---------------- Linear (issue tracker) ----------------
# API key for the Linear workspace v2 publishes into.
LINEAR_API_KEY=
# Team the tracker creates issues against.
LINEAR_TEAM_ID=
# Initiative the tracker links new projects to.
LINEAR_INITIATIVE_ID=

# ---------------- Telegram (chat gateway) ----------------
# Bot token for the v2 chat bridge (separate bot from v1). This is the single
# canonical key — set it here.
TELEGRAM_BOT_TOKEN=
# Deprecated fallback: read only when TELEGRAM_BOT_TOKEN above is unset. Kept
# so existing deployments keep working through the rename; prefer
# TELEGRAM_BOT_TOKEN for new setups and leave this blank.
TELEGRAM_BOT_TOKEN_V2=
# Comma-separated list of numeric Telegram user IDs allowed to drive the
# bot. Outbound notifications also fan out to this list — leave empty to
# silence both directions.
TELEGRAM_ALLOWED_USER_IDS=
# OPTIONAL override: pin the Telegram free-text chat surface to one fixed
# project + repo. When left blank (the default), the chat repo is resolved
# from CONTEXT instead: the message text is matched against the workspace
# repo/project registry ("why does the catalog build fail?" → catalog),
# the choice is remembered per chat, and when nothing matches the bot asks
# which repo to use ("use <repo>") and then answers the stashed question.
# Set both to force every free-text session onto one repo regardless of
# context (the pre-context-resolution behaviour).
TELEGRAM_CHAT_PROJECT_ID=
TELEGRAM_CHAT_REPO_ID=

# ---------------- agent runner selection ----------------
# Which adapter dispatches agent runs. Unset / "fake" → FakeAgentRunner
# (in-memory, publishes lifecycle events synthetically). "claude-cli" →
# spawn the real `claude` CLI against Anthropic. "deepseek" → spawn the
# `claude` CLI against DeepSeek's Anthropic-compatible endpoint (env
# overlay only — same stream parser, same Cancel path). "cursor-cli" →
# spawn Cursor's `agent` CLI (composer-2.5 by default; per-step prompt
# is handed off via TASK.md to dodge cmd.exe's argv-length cap).
AGENT_RUNNER=fake
# Per-role overrides (uppercase role name). Same values AGENT_RUNNER
# accepts. When ANY of these is set, a role-routing runner wraps the
# selected adapters: each role goes to its mapped adapter; anything
# unmapped falls through to AGENT_RUNNER. Cancel fans out across every
# inner adapter (no extra setup needed). Example: developer on Opus,
# everything else on DeepSeek →
#   AGENT_RUNNER=deepseek
#   AGENT_RUNNER_DEVELOPER=claude-cli
# Valid values: claude-cli | deepseek | cursor-cli | ollama |
# ollama-cloud | fake (the vocabulary lives in core/agents/providers.ts).
AGENT_RUNNER_DEVELOPER=
AGENT_RUNNER_REVIEWER=
AGENT_RUNNER_TESTER=
AGENT_RUNNER_PLANNER=
AGENT_RUNNER_DECOMPOSER=
AGENT_RUNNER_COMMITTER=

# ---------------- claude-cli (agent runner) ----------------
# Path to the `claude` CLI executable. Defaults to `claude` on PATH.
CLAUDE_CMD=
# Agent-auth overrides (both optional; also editable as write-only secrets
# in the manager UI, where a save applies to the NEXT agent spawn without a
# restart). When the CLI's interactive `claude login` OAuth expires, agents
# fail with auth errors and the board shows a red banner — fix it by running
# `claude setup-token` on any machine and pasting the token here or in
# Manager -> Settings. ANTHROPIC_API_KEY is the API-key alternative.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# LAST-RESORT default model. Note where this sits in the chain: a flow
# step's `model:` wins, then the Agents-panel record, then
# config/pipeline.yaml's `default_models`, and only then this. Setting it
# to change which model runs usually changes nothing — set it on the agent
# in the manager UI instead. Kept for setups with no pipeline.yaml in
# scope (e.g. running the runner standalone).
CLAUDE_MODEL=claude-opus-5
# Fallback effort when no CLAUDE_EFFORT_<ROLE> matches. Defaults to "medium".
CLAUDE_EFFORT_DEFAULT=medium
# Per-role effort overrides (role uppercased). Add others as needed.
CLAUDE_EFFORT_DEVELOPER=high
CLAUDE_EFFORT_REVIEWER=medium
CLAUDE_EFFORT_TESTER=medium

# ---------------- DeepSeek (agent runner) ----------------
# Set AGENT_RUNNER=deepseek to route every agent through DeepSeek's
# Anthropic-compatible endpoint. The existing claude-cli adapter is reused
# under the hood — tools, --effort, stream parsing, and Cancel all behave
# identically because the spawned process is still `claude`, just pointed
# at https://api.deepseek.com/anthropic with a DeepSeek API key.
DEEPSEEK_API_KEY=
# Override the base URL if you are routing through a proxy / sidecar.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Effort clamped to high|max (DeepSeek's only supported values). Defaults
# to "max". CLAUDE_EFFORT_* env vars / FlowStep effort metadata pass
# through, but values outside high|max round up to "high" with a warning.
DEEPSEEK_EFFORT_DEFAULT=max
# Per-role model overrides. Leave blank to use the DeepSeek role defaults
# (deepseek-v4-pro for developer / reviewer / planner / decomposer,
#  deepseek-v4-flash for tester / committer).
DEEPSEEK_MODEL_DEVELOPER=
DEEPSEEK_MODEL_REVIEWER=
DEEPSEEK_MODEL_TESTER=
DEEPSEEK_MODEL_PLANNER=
DEEPSEEK_MODEL_DECOMPOSER=
DEEPSEEK_MODEL_COMMITTER=

# ---------------- Ollama (agent runner) ----------------
# Two providers, one adapter, both speaking Ollama's Anthropic-compatible
# /v1/messages endpoint through the `claude` CLI:
#
#   AGENT_RUNNER=ollama-cloud  -> https://ollama.com      (needs a key)
#   AGENT_RUNNER=ollama        -> http://localhost:11434  (no key)
#
# They are separate providers because the base URL belongs to the runner,
# not to the spawn: keeping both lets per-role routing send one role to
# the cloud and another to a local model, e.g.
#   AGENT_RUNNER=ollama
#   AGENT_RUNNER_DEVELOPER=ollama-cloud
#
# A MODEL TAG IS MANDATORY for either provider — there is no sensible
# default, since the tag has to name something the server actually
# serves. The provider refuses to start without it (and is skipped with a
# warning unless it is the AGENT_RUNNER fallback).
# Local examples: qwen3-coder:30b, devstral:24b. Cloud uses the `:cloud`
# tag, e.g. gemma4:cloud. `claude-*` ids from pipeline.yaml
# default_models are stripped so they cannot reach Ollama's registry.
OLLAMA_MODEL=
# Smaller/faster tag for the roles the CLI resolves as "haiku" and for
# its own subagents. Defaults to OLLAMA_MODEL, so one tag serves all.
OLLAMA_SMALL_MODEL=
# Cloud credential. Required by AGENT_RUNNER=ollama-cloud; the local
# daemon ignores tokens entirely. Sent as `Authorization: Bearer` —
# the cloud endpoint does not accept x-api-key alone. Write-only: the
# value never appears in logs, only the key name.
OLLAMA_API_KEY=
# Base-URL overrides. Only needed for a non-default host (a remote
# daemon, an enterprise gateway, a proxy).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# The LOCAL server's context window in tokens, mirroring whatever you set
# as OLLAMA_CONTEXT_LENGTH on the daemon.
#
# Set this. Ollama does not reject an oversized prompt: it drops tokens
# from the FRONT, keeps the tail and answers with a normal 200. The front
# of every task prompt here is the `# !!! WORKSPACE BOUNDARIES` block, so
# a too-small window silently removes the rail that keeps agents out of
# your personal checkouts. With a figure here the runner logs a loud
# error when a prompt will not fit; without one it cannot tell.
# The daemon's own default is small (VRAM-derived, often 4096) however
# large a context the model advertises.
OLLAMA_CONTEXT_TOKENS=
# Per-role model overrides (same shape as the DeepSeek / Cursor ones).
OLLAMA_MODEL_DEVELOPER=
OLLAMA_MODEL_REVIEWER=
OLLAMA_MODEL_TESTER=
OLLAMA_MODEL_PLANNER=
OLLAMA_MODEL_DECOMPOSER=
OLLAMA_MODEL_COMMITTER=

# ---------------- Cursor (agent runner) ----------------
# Set AGENT_RUNNER=cursor-cli (or AGENT_RUNNER_<ROLE>=cursor-cli) to spawn
# the Cursor `agent` CLI. Requires `agent` on PATH; auth via `agent login`
# or the CURSOR_API_KEY env var. The runner passes --force / --trust /
# --approve-mcps so tools + MCPs run without confirmation, matching the
# claude-cli adapter's posture. No --effort flag — Cursor encodes
# reasoning in the model id (e.g. sonnet-4 vs sonnet-4-thinking).
CURSOR_CMD=                    # path to the binary; defaults to "agent"
CURSOR_API_KEY=                # optional if `agent login` was used
CURSOR_MODEL=composer-2.5      # global default — applies to every role
CURSOR_MODEL_DEVELOPER=
CURSOR_MODEL_REVIEWER=
CURSOR_MODEL_TESTER=
CURSOR_MODEL_PLANNER=
CURSOR_MODEL_DECOMPOSER=
CURSOR_MODEL_COMMITTER=

# ---------------- operator profile ----------------
# Folder holding YOUR configuration, layered over the app's built-in
# defaults: personas, flows, the pipeline.yaml keys you changed, settings
# and secrets (see docs/configuration.md "The operator profile"). The app
# reads it and the manager UI writes to it; a `git pull` of the app never
# touches it. Defaults to `~/.dropagents`. Must be ABSOLUTE and OUTSIDE this
# repo. Set it HERE rather than in your shell: this file is only read by
# the hosts, so `npm test` never sees your personal config. Windows
# services running under a system account need it too - their `~` is the
# system profile, not yours. Create it with `npm run profile:init`.
# Once the profile exists, this can be the only line left in this file.
PIPELINE_HOME=

# ---------------- pipeline workspace ----------------
# Root directory the orchestrator clones repos into and lays task
# worktrees under. Defaults to `C:\Drop-AI\Source` on Windows and
# `~/Drop-AI/Source` elsewhere — both deliberately outside any common
# operator-checkout tree, so claude / cursor's CLAUDE.md walk (from the
# worktree upward) never finds the operator's personal repos and the
# agent has no on-disk path to anchor a wrong-write against.
# Worktrees land at <root>\worktrees\<taskId>; clones at <root>\repos\<repoId>.
PIPELINE_WORKSPACE_ROOT=C:\Drop-AI\Source
# REPOS_ROOT (legacy override) still wins for the clones half when set —
# leave unset to inherit from PIPELINE_WORKSPACE_ROOT.
REPOS_ROOT=

# SQLite state DB — the event log and every projection. Defaults to
# `<repo-root>/.pipeline-state.db`. EVERY process that opens it resolves
# this the same way (worker, manager-api, operator scripts), which is what
# keeps them on one file; a relative value resolves against the REPO ROOT,
# not the shell's cwd, because the hosts are launched from different
# places. Leave unset unless you deliberately want the DB elsewhere.
PIPELINE_STATE_DB=

# Days of AgentActivity/AgentProgress streaming telemetry to keep in the
# event log. These rows only matter while the emitting agent is alive
# (board streams); nothing folds them historically and boot replay skips
# them, but at ~80% of a mature log they dominate db size. Pruned at
# every orchestrator boot. Default 7; 0 disables pruning entirely.
# SQLite reuses the freed pages (the file stops growing); to shrink the
# file itself run, with the worker STOPPED:
#   npm run vacuum:db
PIPELINE_TELEMETRY_RETENTION_DAYS=7

# ---------------- Prompt dumping (debugging, OFF by default) ----------
# Write each composed prompt to disk just before it goes down the agent's
# stdin. The prompt is otherwise never persisted — it travels over stdin,
# not argv, and only its LENGTH is logged — so a run the API rejects
# ("safeguards flagged this message", a context-length error) cannot be
# examined afterwards: the exact bytes that were refused are gone.
#
# Turn it on, reproduce the failure once, read the file, turn it off.
#
#   unset / 0 / false / off / no   disabled (the default)
#   1 / true / on / yes / all / *  every role
#   <role>,<role>                  only those roles
#
# Prefer the role list. On a busy worker "all" also writes a copy of every
# task prompt, and the question is almost always about one role:
# PIPELINE_DUMP_PROMPTS=decomposer,planner
#
# READ THIS BEFORE ENABLING: a dump is the WHOLE prompt. For a lifecycle
# agent that means the brief, the project context, the operator feedback
# in agent-memory.jsonl, and up to 32 KiB apiece of source from the target
# repo. Treat the files as you would the repos they quote, and delete them
# when you are done — nothing prunes them.
#
# Written to <tmp>/dropagents/prompts by default — deliberately
# outside any repo, so an enabled dump cannot drop files into a working
# tree. The exact path is logged at INFO on every dump. Override with:
# PIPELINE_DUMP_PROMPTS_DIR=C:\some\where
PIPELINE_DUMP_PROMPTS=

# ---------------- Azure service principal (optional) ----------------
# Used by TWO different consumers, which authenticate DIFFERENTLY:
#   * the Azure SDK (state backup, config store) reads these three env
#     vars directly via DefaultAzureCredential's EnvironmentCredential;
#   * the `az` CLI does NOT read them — it trusts only its own login
#     cache. Deploy/diagnostic agents therefore run
#     `az login --service-principal -u $env:AZURE_CLIENT_ID
#      -p $env:AZURE_CLIENT_SECRET --tenant $env:AZURE_TENANT_ID`
#     when an az command reports a missing token (see
#     agents/deployer.CLAUDE.md). Setting these three is what makes the
#     worker able to deploy headlessly, without an interactive az login
#     that expires.
# The identity needs its data-plane roles assigned (e.g. Storage Blob
# Data Contributor) — control-plane Owner/Contributor is NOT enough.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Days a chat session may sit UNTOUCHED before the daily sweep deletes it
# (with its messages). `updated_at` is the activity signal, so a
# long-running conversation is never removed no matter how old it is.
# Scratch-edit sessions have their git worktree torn down first, through
# the same path the board's Delete button uses. Default 14; 0 disables.
PIPELINE_CHAT_RETENTION_DAYS=14
# Hours between sweeps (default 24 — daily). One sweep also runs at boot.
PIPELINE_CHAT_RETENTION_HOURS=24

# ---------------- architect tier (optional) ----------------
# repoId of the workspace-wide "architecture" repo the architect tier commits
# each requirement's design doc into on approval (requirements/<id>/design.md
# + rollout.md, pushed to the repo's default branch). Must be a repo already
# REGISTERED in the workspace (added via the board's Repos modal so it's
# cloned with an ensured path); the commit is skipped best-effort if unset or
# the repo isn't cloned. Everything else in the architect tier (design,
# proposal, board rendering, fan-out) works without it.
PIPELINE_ARCHITECTURE_REPO_ID=

# ---------------- git-cli (source control) ----------------
# Required by GitCli.commit() — the adapter throws if either is missing.
GIT_COMMIT_NAME=
GIT_COMMIT_EMAIL=

# ---------------- worker-api host ----------------
# Shared secret between the v2 board and v2 worker-api (bearer-token auth).
# If unset the server runs unauthenticated (localhost-only mode).
WORKER_API_TOKEN_V2=
# HTTP port for the worker-api. Defaults to 4101.
WORKER_API_PORT=4101
# Bind address for the worker-api. Defaults to 127.0.0.1 (loopback only —
# unreachable from other machines even with a firewall rule). Set to
# 0.0.0.0 to accept LAN connections; ALWAYS set WORKER_API_TOKEN_V2 first.
WORKER_API_HOST=127.0.0.1

# ---------------- manager-api / manager-board hosts ----------------
# Management API port / bind host. Defaults to 4102 / 127.0.0.1. Set the
# host to a non-loopback address (e.g. a Tailscale IP or 0.0.0.0) to
# reach it from another machine; auth reuses WORKER_API_TOKEN_V2.
MANAGER_API_PORT=4102
MANAGER_API_HOST=127.0.0.1
# Management UI static server port / bind host. Defaults to 4103 / 127.0.0.1.
MANAGER_BOARD_PORT=4103
MANAGER_BOARD_HOST=127.0.0.1
# Required to start with MANAGER_BOARD_HOST set to anything but loopback.
# This UI has NO auth of its own and its proxy adds the manager-api token
# to every forwarded request, so reaching the port grants CONFIG WRITE
# access. The flag is not a credential — it exists so that exposing an
# unauthenticated control plane cannot happen by accident. Set it only on
# a private network (Tailscale/VPN) or behind an authenticating proxy.
MANAGER_BOARD_ALLOW_REMOTE=
# Manager-api origin the management UI proxies to. Defaults to
# http://127.0.0.1:4102.
MANAGER_API_URL=http://127.0.0.1:4102

# ---------------- board-ui host ----------------
# Static-file server port / bind host. Defaults to 4100 / 127.0.0.1.
BOARD_UI_PORT=4100
BOARD_UI_HOST=127.0.0.1
# Required to start with BOARD_UI_HOST set to anything but loopback. The
# board has NO auth of its own and its proxy adds WORKER_API_TOKEN_V2 to
# every forwarded request, so reaching the port grants full control of the
# pipeline — and agents run with --dangerously-skip-permissions. Prefer an
# SSH tunnel; set this only for a private network (Tailscale/VPN) or an
# authenticating reverse proxy.
BOARD_UI_ALLOW_REMOTE=
# Worker-api origin the board proxies /events and /commands to. Defaults
# to http://127.0.0.1:4101. The `WORKER_API_TOKEN_V2` above (if set) is
# injected as a Bearer token on every proxied request.
WORKER_API_URL=http://127.0.0.1:4101

# ---------------- Jira shadow-mode (optional) ----------------
# Only required when pipeline.yaml sets `issue_tracker_shadow: jira`.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---------------- State DB backup / multi-machine failover (optional) ----
# Continuous whole-file backup of .pipeline-state.db to Azure Blob Storage.
# The running worker online-snapshots the DB every interval (plus once on a
# clean shutdown); a machine that boots WITHOUT a local state DB restores
# the latest backup first — so failover is: stop (or lose) the primary,
# start the worker-api on another machine with the same env, and continue.
# A lease on a lock blob prevents two live workers from clobbering each
# other's backups. Auth: DefaultAzureCredential (az login / service
# principal / managed identity) with Storage Blob Data Contributor.
# An existing local DB is NEVER overwritten — delete it to force a restore.
PIPELINE_STATE_BACKUP=
PIPELINE_STATE_BACKUP_CONTAINER=pipeline-state
PIPELINE_STATE_BACKUP_INTERVAL_MIN=5

# ---------------- Local daily DB snapshots (optional) ----------------
# A second, independent safety net from PIPELINE_STATE_BACKUP above: a
# daily `VACUUM INTO shared/.cache/snapshots/state-YYYY-MM-DD.db`, keeping
# the most recent SNAPSHOT_RETAIN files. Local-only — no Azure, no
# credentials — so it is the cheapest point-in-time recovery available,
# and the snapshots are compacted copies, which also makes them a free
# answer to "is the big state DB real data or reclaimable slack?"
# OFF BY DEFAULT so tests do not have to clean up snapshot files, and
# undocumented here until a field worker turned out to have no snapshots
# directory at all: an operator cannot enable a flag nobody wrote down.
# Costs disk: SNAPSHOT_RETAIN x the DB size. Check `npm run db:report`
# before enabling it on a worker with a large state DB.
SNAPSHOTS_ENABLED=
SNAPSHOT_RETAIN=7

# ---------------- ConfigStore — Azure backend (optional) ----------------
# Only required when pipeline.yaml `config_store.backend_kind` is `azure`
# or `dual`. Defaults to `fs` (no Azure dependency).
PIPELINE_STORE_BACKEND=fs
PIPELINE_STORE_TENANT=default
AZURE_STORAGE_ACCOUNT_URL=
PIPELINE_STORE_OVERFLOW_THRESHOLD_BYTES=
PIPELINE_STORE_OVERFLOW_CONTAINER=

# ---------------- Auto-merge (queued merges) ----------------
# `gh pr merge` demands the merge NOW, so on a repo whose required checks
# run on the pull request every merge failed with "is not mergeable: the
# base branch policy prohibits the merge". The pipeline now retries with
# `--auto`, which hands the merge to GitHub to run when the checks pass,
# and then WATCHES the PR so the task finishes by itself.
#
# How often to ask GitHub whether the queued merge has landed. Required
# checks take minutes, so a tighter poll only burns API quota. Values
# below 5 are ignored (a typo must not spin).
PIPELINE_AUTO_MERGE_POLL_SECONDS=60
# How long to keep watching. On expiry the task stays parked at
# wait-merged with the manual Merge PR button, and its parked note says
# the pipeline stopped waiting — the auto-merge is still queued with
# GitHub and may yet land on its own.
PIPELINE_AUTO_MERGE_TIMEOUT_MINUTES=60
